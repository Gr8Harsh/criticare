DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
SESSION_SECRET=replace-with-a-long-random-secret
PORT=5000

# Production safety switches
# Set this to true only on the first production deploy if you want default rooms/doctors seeded.
SEED_DEFAULT_DATA=false

# Keep false in production unless you intentionally want test logins created.
ENABLE_DEMO_USERS=false
